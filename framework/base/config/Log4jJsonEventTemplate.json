{
  "timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "severity": {
    "$resolver": "level",
    "field" : "name"
  },
  "logging.googleapis.com/logger": {
    "$resolver" : "logger",
    "field" : "fqcn"
  },
  "logging.googleapis.com/thread": {
    "$resolver" : "thread",
    "field" : "name"
  },
  "message": {
    "$resolver" : "message",
    "stringified" : true
  },

  "logging.googleapis.com/sourceLocation": {
    "$resolver": "source",
    "includeClass": true,
    "includeMethod": true,
    "includeFile": true,
    "includeLine": true
  },

  "serviceContext": {
    "service": "cdc-ofbiz-tickets",
    "version": "@VERSION@"
  },

  "trace": {
    "$resolver": "mdc",
    "key": "traceId"
  },
  "spanId": {
    "$resolver": "mdc",
    "key": "spanId"
  },

  "exception": {
    "$resolver": "exception",
    "field": "stackTrace",
    "stringified": true
  }
}
